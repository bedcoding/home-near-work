{
  "name": "home-near-work",
  "private": true,
  "version": "0.1.0",
  "description": "회사근처 내집마련 — 설정한 지역의 매물을 조회해서 신규·가격 변동만 알려 주는 개인용 도구",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,green \"tsx watch server/index.ts\" \"vite\"",
    "build": "vite build",
    "start": "vite build && tsx server/index.ts --open",
    "serve": "tsx server/index.ts --open",
    "typecheck": "tsc --noEmit && vue-tsc --noEmit -p web/tsconfig.json"
  },
  "dependencies": {
    "@fastify/static": "^10.1.4",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.12.5",
    "node-notifier": "^10.0.1",
    "open": "^11.0.4",
    "playwright": "^1.63.0",
    "proj4": "^2.22.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.2",
    "@types/node-notifier": "^8.0.5",
    "@types/proj4": "^2.5.6",
    "@vitejs/plugin-vue": "^6.0.9",
    "concurrently": "^10.0.5",
    "leaflet": "^1.9.4",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vue": "^3.5.43",
    "vue-tsc": "^3.3.11"
  }
}
